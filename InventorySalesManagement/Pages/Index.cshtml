@page
@model IndexModel
@using System.Data
@using System.Globalization
@{
    ViewData["Title"] = "Overview";
    bool admin = User.IsInRole("Administrator");
    decimal maxSale = Model.SalesDays.Count > 0 ? Model.SalesDays.Max(day => day.Amount) : 0;
    int totalAlerts = Model.LowStockCount + Model.ExpiringCount + Model.ExpiredCount;
    decimal financialResult = Model.MonthRevenue - Model.MonthStockCost - Model.MonthExpiryCost;
}
<div class="dashboard-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div><div class="eyebrow">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</div><h1 class="dashboard-title">@(admin ? "Business overview" : "Sales workspace")</h1><p class="text-secondary mb-0">@(admin ? "See sales and stock that need your attention." : "Record a sale and keep an eye on available stock.")</p></div>
    <a asp-page="/Sales/Create" class="btn btn-primary px-4 py-2">+ New sale</a>
</div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Today's sales</span><strong>@Model.TodaySales.ToString("N2")</strong><small>@Model.TodayCount transaction(s) today</small></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Last 7 days</span><strong>@Model.WeekSales.ToString("N2")</strong><small>@if (Model.PreviousWeekSales > 0) { <text>@(((Model.WeekSales - Model.PreviousWeekSales) / Model.PreviousWeekSales * 100).ToString("+0.0;-0.0;0.0"))% vs previous 7 days</text> } else { <text>No previous sales to compare</text> }</small></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Low-stock products</span><strong>@Model.LowStockCount</strong><small>At or below reorder level</small></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Expiry alerts</span><strong>@(Model.ExpiringCount + Model.ExpiredCount)</strong><small>@Model.ExpiringCount within 7 days · @Model.ExpiredCount expired</small></div></div>
    </div>
    @if (admin)
    {
        <section class="dashboard-card financial-overview mb-4" aria-labelledby="financial-heading">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div><h2 class="section-title" id="financial-heading">Profit and stock loss estimate</h2><p class="section-subtitle mb-0">@Model.FinancialStart.ToString("dd MMM") – @Model.FinancialAsOf.ToString("dd MMM yyyy")</p></div>
                <span class="financial-label">Month to date</span>
            </div>
            <div class="row g-3">
                <div class="col-6 col-xl-3"><div class="financial-metric"><span>Sales revenue</span><strong>@Model.MonthRevenue.ToString("N2")</strong></div></div>
                <div class="col-6 col-xl-3"><div class="financial-metric"><span>Cost of stock sold</span><strong>@if (Model.MissingCostItems > 0) { <text>Incomplete</text> } else { @Model.MonthStockCost.ToString("N2") }</strong></div></div>
                <div class="col-6 col-xl-3"><div class="financial-metric"><span>Estimated expiry loss</span><strong class="text-danger">@Model.MonthExpiryCost.ToString("N2")</strong></div></div>
                <div class="col-6 col-xl-3"><div class="financial-metric financial-result"><span>After stock and expiry</span><strong>@if (Model.MissingCostItems > 0) { <text>Unavailable</text> } else { @financialResult.ToString("N2") }</strong>@if (Model.MissingCostItems == 0) { <small class="d-block text-secondary">@(financialResult < 0 ? "Estimated loss" : financialResult > 0 ? "Estimated surplus" : "Break even")</small> }</div></div>
            </div>
            @if (Model.MissingCostItems > 0) { <p class="financial-note text-danger mb-1">@Model.MissingCostItems sale item(s) have incomplete batch cost records. Complete them to calculate this estimate.</p> }
            <p class="financial-note mb-0">Estimate, not net profit: excludes rent, wages, taxes and other expenses. Expiry loss uses the purchase cost of stock still recorded on batches that expired this month; it may change if stock records are corrected.</p>
        </section>
    }
    <div class="row g-4">
        <div class="col-lg-8">
            <section class="dashboard-card h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><h2 class="section-title">Sales activity</h2><p class="section-subtitle">Daily sales value over the last 7 days</p></div><a asp-page="/Reports/Sales" class="small fw-semibold text-decoration-none">View report &rarr;</a></div>
                @if (maxSale == 0) { <div class="chart-empty">No sales recorded in the last 7 days.</div> }
                else {
                    <div class="sales-chart" role="img" aria-label="Daily sales for the last seven days">
                        @foreach (var day in Model.SalesDays) {
                            var height = maxSale > 0 ? (day.Amount / maxSale * 100).ToString("0.##", CultureInfo.InvariantCulture) : "0";
                            <div class="chart-column" title="@day.Date.ToString("dd MMM"): @day.Amount.ToString("N2")"><span class="chart-value">@day.Amount.ToString("N0")</span><div class="chart-track"><div class="chart-bar" style="height: @(height)%"></div></div><span class="chart-day">@day.Date.ToString("ddd")</span></div>
                        }
                    </div>
                }
            </section>
        </div>
        <div class="col-lg-4">
            <section class="dashboard-card h-100"><h2 class="section-title">Quick access</h2><p class="section-subtitle">Get to your most-used tasks</p>
                <div class="quick-links"><a asp-page="/Sales/Create"><span>Record a sale</span><span>&rarr;</span></a><a asp-page="/Sales/Index"><span>Sales history</span><span>&rarr;</span></a><a asp-page="/Batches/Index"><span>View stock batches</span><span>&rarr;</span></a>
                @if (admin) { <a asp-page="/Receipts/Create"><span>Receive stock</span><span>&rarr;</span></a><a asp-page="/Products/Index"><span>Manage products</span><span>&rarr;</span></a> }
                </div>
            </section>
        </div>
        <div class="col-lg-8">
            <section class="dashboard-card"><div class="d-flex justify-content-between align-items-start gap-2"><div><h2 class="section-title">Needs attention</h2><p class="section-subtitle">Low stock and batches nearing expiry</p></div><a asp-page="/Dashboard/Index" class="small fw-semibold text-decoration-none">All alerts &rarr;</a></div>
                @if (totalAlerts == 0) { <p class="text-secondary mb-0">No stock or expiry alerts right now.</p> }
                else {
                    <div class="attention-list">
                    @foreach (DataRow row in Model.LowStock.AsEnumerable().Take(4)) { <div><span><strong>@row["ProductName"]</strong><small>Low stock · @row["Available"] available</small></span><span class="status-pill warning">Reorder</span></div> }
                    @foreach (DataRow row in Model.NearExpiry.AsEnumerable().Take(3)) { <div><span><strong>@row["ProductName"]</strong><small>@row["QuantityRemaining"] remaining · expires @Convert.ToDateTime(row["ExpiryDate"]).ToString("dd MMM")</small></span><span class="status-pill warning">Soon</span></div> }
                    @foreach (DataRow row in Model.Expired.AsEnumerable().Take(3)) { <div><span><strong>@row["ProductName"]</strong><small>@row["QuantityRemaining"] remaining · expired @Convert.ToDateTime(row["ExpiryDate"]).ToString("dd MMM")</small></span><span class="status-pill danger">Expired</span></div> }
                    </div>
                }
            </section>
        </div>
        <div class="col-lg-4"><section class="dashboard-card h-100"><h2 class="section-title">Stock at a glance</h2><p class="section-subtitle">Current inventory</p><div class="stock-stat"><span>Active products</span><strong>@Model.ProductCount</strong></div><div class="stock-stat"><span>Low stock</span><strong>@Model.LowStockCount</strong></div><div class="stock-stat"><span>Expired batches</span><strong>@Model.ExpiredCount</strong></div><a asp-page="/Reports/Inventory" class="btn btn-outline-primary w-100 mt-4">View inventory report</a></section></div>
    </div>
}
