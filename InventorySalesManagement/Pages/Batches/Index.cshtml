@page
@model InventorySalesManagement.Pages.Batches.IndexModel
@{ ViewData["Title"] = "Stock Batches"; }
<h1>Stock batches</h1>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<p><a asp-page="/Receipts/Create" class="btn btn-primary">Receive stock</a> <a asp-page="/Receipts/Index" class="btn btn-outline-secondary">Receipt history</a></p>
<table class="table table-striped table-bordered"><thead><tr><th>Product</th><th>Supplier</th><th>Receipt</th><th>Received</th><th>Remaining</th><th>Purchase cost</th><th>Expiry date</th></tr></thead><tbody>
@foreach (var batch in Model.Batches)
{
	<tr><td>@batch.ProductName</td><td>@batch.SupplierName</td><td><a asp-page="/Receipts/Details" asp-route-id="@batch.StockReceiptId">#@batch.StockReceiptId</a></td><td>@batch.QuantityReceived</td><td>@batch.QuantityRemaining</td><td>@batch.UnitCost.ToString("C")</td><td>@(batch.ExpiryDate?.ToString("d") ?? "No expiry")</td></tr>
}
</tbody></table>
@if (Model.Batches.Count == 0) { <p class="text-secondary">No stock batches found.</p> }
