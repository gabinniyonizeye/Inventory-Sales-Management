@page
@model InventorySalesManagement.Pages.Batches.IndexModel
@{ ViewData["Title"] = "Stock Batches"; }
<h1>Stock batches</h1>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<p>@if (User.IsInRole("Administrator")) { <a asp-page="/Receipts/Create" class="btn btn-primary">Receive stock</a> } <a asp-page="/Receipts/Index" class="btn btn-outline-secondary">Receipt history</a></p>
<table class="table table-striped table-bordered"><thead><tr><th>Product</th><th>Supplier</th><th>Receipt</th><th>Received</th><th>Remaining</th><th>Purchase cost</th><th>Expiry date</th><th>Status</th></tr></thead><tbody>
@foreach (var batch in Model.Batches)
{
	<tr><td>@batch.ProductName</td><td>@batch.SupplierName</td><td><a asp-page="/Receipts/Details" asp-route-id="@batch.StockReceiptId">#@batch.StockReceiptId</a></td><td>@batch.QuantityReceived</td><td>@batch.QuantityRemaining</td><td>@batch.UnitCost.ToString("C")</td><td>@(batch.ExpiryDate?.ToString("d") ?? "No expiry")</td><td>@if (batch.ExpiryDate.HasValue && batch.ExpiryDate.Value.Date < DateTime.Today) { <span class="badge bg-danger">Expired</span> } else if (batch.ExpiryDate.HasValue && batch.ExpiryDate.Value.Date <= DateTime.Today.AddDays(7)) { <span class="badge bg-warning text-dark">Near expiry</span> } else { <span class="text-secondary">—</span> }</td></tr>
}
</tbody></table>
@if (Model.Batches.Count == 0) { <p class="text-secondary">No stock batches found.</p> }
