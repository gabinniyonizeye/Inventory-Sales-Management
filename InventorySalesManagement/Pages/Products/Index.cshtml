@page
@model InventorySalesManagement.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<!-- WHY: This form uses method="get" so the search filters are added to the URL. -->
<form method="get" class="form-inline mb-3">
    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control mr-sm-2" placeholder="Search product name..." />

    <!-- WHY: We use asp-items to build the dropdown from our CategoryList -->
    <select name="CategoryFilter" asp-items="Model.CategoryList" class="form-control mr-sm-2">
        <option value="">All Categories</option>
    </select>

    <button type="submit" class="btn btn-outline-success">Search</button>
    <a asp-page="./Index" class="btn btn-link">Clear</a>
</form>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Product</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Available Stock</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.SellingPrice.ToString("C")</td>
                <td>
                    @item.AvailableQuantity @item.Unit

                    <!-- WHY: This checks the requirement "clear low-stock status". If stock is less than or equal to the reorder level, we show a red warning badge. -->
                    @if (item.AvailableQuantity <= item.ReorderLevel)
                    {
                        <span class="badge bg-danger">Low Stock</span>
                    }
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">Details</a>

                    <!-- WHY: Deactivation form to preserve historical records as required -->
                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@item.ProductId" style="display:inline;">
                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                            @(item.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>