@page
@model InventorySalesManagement.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<h2>Edit Category</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- WHY: Hidden field is very important. It tells the C# code which CategoryId is being edited. -->
            <input type="hidden" asp-for="Category.CategoryId" />

            <div class="form-group mb-3">
                <label asp-for="Category.CategoryName" class="control-label">Category Name</label>
                <input asp-for="Category.CategoryName" class="form-control" />
                <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.Description" class="control-label"></label>
                <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Category.Description" class="text-danger"></span>
            </div>

            <!-- WHY: We don't show the IsActive checkbox here because the assignment says we handle activation/deactivation on the Index page. But we keep it hidden so it doesn't get lost -->
            <input type="hidden" asp-for="Category.IsActive" />

            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>