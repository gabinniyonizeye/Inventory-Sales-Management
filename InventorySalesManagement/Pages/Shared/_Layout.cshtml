<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory and Sales</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <nav class="navbar navbar-expand-lg navbar-light py-3">
        <div class="container-xxl px-lg-4">
            <a class="navbar-brand app-brand" asp-page="/Index"><span class="brand-mark">IS</span><span>Inventory<span class="brand-sub"> &amp; Sales</span></span></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Overview</a></li>
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sales</a><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Sales/Create">New sale</a></li><li><a class="dropdown-item" asp-page="/Sales/Index">Sales history</a></li></ul></li>
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Inventory</a><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Products/Index">Products</a></li><li><a class="dropdown-item" asp-page="/Categories/Index">Categories</a></li><li><a class="dropdown-item" asp-page="/Batches/Index">Stock batches</a></li>@if (User.IsInRole("Administrator")) { <li><hr class="dropdown-divider" /></li><li><a class="dropdown-item" asp-page="/Suppliers/Index">Suppliers</a></li><li><a class="dropdown-item" asp-page="/Receipts/Index">Stock receipts</a></li> }</ul></li>
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Reports/Sales">Sales report</a></li><li><a class="dropdown-item" asp-page="/Reports/Inventory">Inventory report</a></li></ul></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Dashboard/Index">Alerts <span id="alert-count" class="badge text-bg-danger" hidden></span></a></li>
                        @if (User.IsInRole("Administrator")) { <li class="nav-item"><a class="nav-link" asp-page="/Users/Index">Users</a></li> }
                    </ul>
                    <div class="d-flex flex-wrap align-items-center gap-3 nav-account"><span class="small text-secondary">@User.Identity.Name<br /><span class="account-role">@(User.IsInRole("Administrator") ? "Administrator" : "Sales staff")</span></span><form method="post" asp-page="/Account/Logout"><button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button></form></div>
                </div>
            }
        </div>
    </nav>
</header>
<main class="container-xxl px-lg-4 py-4 py-lg-5">@RenderBody()</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script>
        function updateAlertCount() {
            fetch('/Dashboard?handler=Data', { credentials: 'same-origin' })
                .then(function (response) { if (!response.ok) throw new Error(); return response.json(); })
                .then(function (data) {
                    var count = data.lowStock.length + data.nearExpiry.length + data.expired.length;
                    var badge = document.getElementById('alert-count');
                    badge.textContent = count;
                    badge.hidden = count === 0;
                    badge.title = count + ' stock and expiry alerts';
                })
                .catch(function () {
                    var badge = document.getElementById('alert-count');
                    badge.textContent = '!';
                    badge.hidden = false;
                    badge.title = 'Alerts could not be updated';
                });
        }
        updateAlertCount();
        setInterval(updateAlertCount, 30000);
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
