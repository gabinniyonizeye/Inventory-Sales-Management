@page
@model InventorySalesManagement.Pages.Reports.SalesModel
@using System.Data
@{
    ViewData["Title"] = "Sales report";
    var fromText = Model.From?.ToString("yyyy-MM-dd");
    var toText = Model.To?.ToString("yyyy-MM-dd");
}

<h2>Sales report</h2>
<p class="text-muted">From @fromText to @toText</p>

<form method="get" class="row g-2 mb-3 d-print-none">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="From" class="form-control" value="@fromText" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="To" class="form-control" value="@toText" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Show report</button>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</form>

<h4>Total for period: @Model.GrandTotal.ToString("N2")</h4>

<div class="d-flex align-items-center gap-3 mt-4">
    <h5 class="mb-0">Sales per day</h5>
    <a class="btn btn-outline-primary btn-sm d-print-none"
       href="/Reports/Sales?handler=Download&part=days&From=@fromText&To=@toText">Download CSV</a>
</div>
@if (Model.ByDay.Rows.Count == 0)
{
    <p class="text-muted">No sales in this period.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead><tr><th>Date</th><th>Sales</th><th class="text-end">Total</th></tr></thead>
        <tbody>
            @foreach (DataRow r in Model.ByDay.Rows)
            {
                <tr>
                    <td>@(((DateTime)r["SaleDay"]).ToString("yyyy-MM-dd"))</td>
                    <td>@r["SalesCount"]</td>
                    <td class="text-end">@(((decimal)r["TotalAmount"]).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex align-items-center gap-3 mt-4">
    <h5 class="mb-0">Products sold</h5>
    <a class="btn btn-outline-primary btn-sm d-print-none"
       href="/Reports/Sales?handler=Download&part=products&From=@fromText&To=@toText">Download CSV</a>
</div>
@if (Model.ByProduct.Rows.Count == 0)
{
    <p class="text-muted">No products sold in this period.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead><tr><th>Product</th><th>Quantity sold</th><th class="text-end">Revenue</th></tr></thead>
        <tbody>
            @foreach (DataRow r in Model.ByProduct.Rows)
            {
                <tr>
                    <td>@r["ProductName"]</td>
                    <td>@r["QuantitySold"]</td>
                    <td class="text-end">@(((decimal)r["Revenue"]).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
}