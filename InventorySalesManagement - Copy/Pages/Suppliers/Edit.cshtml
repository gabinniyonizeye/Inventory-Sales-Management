@page "{id:int}"
@model InventorySalesManagement.Pages.Suppliers.EditModel
@{ ViewData["Title"] = "Edit Supplier"; }
<h1>Edit supplier</h1>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<form method="post" class="row g-3">
	<input type="hidden" asp-for="Supplier.SupplierId" />
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="col-md-6"><label asp-for="Supplier.SupplierName" class="form-label"></label><input asp-for="Supplier.SupplierName" class="form-control" /><span asp-validation-for="Supplier.SupplierName" class="text-danger"></span></div>
	<div class="col-md-6"><label asp-for="Supplier.Phone" class="form-label"></label><input asp-for="Supplier.Phone" class="form-control" /><span asp-validation-for="Supplier.Phone" class="text-danger"></span></div>
	<div class="col-md-6"><label asp-for="Supplier.Email" class="form-label"></label><input asp-for="Supplier.Email" class="form-control" /><span asp-validation-for="Supplier.Email" class="text-danger"></span></div>
	<div class="col-md-6"><label asp-for="Supplier.Address" class="form-label"></label><input asp-for="Supplier.Address" class="form-control" /><span asp-validation-for="Supplier.Address" class="text-danger"></span></div>
	<div class="col-12 form-check ms-2"><input asp-for="Supplier.IsActive" class="form-check-input" /><label asp-for="Supplier.IsActive" class="form-check-label">Active</label></div>
	<div class="col-12"><button class="btn btn-primary">Save changes</button> <a asp-page="Index" class="btn btn-link">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
