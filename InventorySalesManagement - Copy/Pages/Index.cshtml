@page
@model IndexModel
@{ ViewData["Title"] = "Home"; }
<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <p class="text-primary text-uppercase fw-semibold small mb-2">Inventory and sales</p>
                <h1 class="display-6 fw-semibold mb-3">Welcome, @User.Identity?.Name</h1>
                <p class="text-secondary fs-5 mb-0">Manage products, stock and sales in one place.</p>
                @if (User.IsInRole("Administrator"))
                {
                    <div class="mt-4"><a asp-page="/Users/Index" class="btn btn-primary">Manage users</a></div>
                }
            </div>
        </div>
    </div>
</div>
