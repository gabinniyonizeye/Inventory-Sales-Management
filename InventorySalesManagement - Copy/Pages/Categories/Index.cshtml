@page
@model InventorySalesManagement.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>

<!-- WHY: This shows a green success message after saving or updating -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (User.IsInRole("Administrator"))
{
<p>
    <!-- WHY: The asp-page tag helper generates a link to the Create page -->
    <a asp-page="Create" class="btn btn-primary">Create New Category</a>
</p>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- WHY: We loop through our C# model to build the table rows dynamically -->
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {

                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Administrator"))
                    {
                    <!-- WHY: Links to the Edit page, passing the specific CategoryId -->
                    <a asp-page="./Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Edit</a>

                    <!-- WHY: A form that posts to our OnPostToggleStatusAsync method -->
                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@item.CategoryId" style="display:inline;">
                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                            @(item.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>