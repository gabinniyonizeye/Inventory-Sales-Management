@page
@model InventorySalesManagement.Pages.Users.EditModel
@{ ViewData["Title"] = "Edit user"; }
<div class="mb-4"><a asp-page="/Users/Index" class="text-decoration-none">&larr; Back to users</a></div>
<div class="row"><div class="col-lg-8 col-xl-7">
    <div class="mb-4"><p class="text-primary text-uppercase fw-semibold small mb-1">Administration</p><h1 class="h2 fw-bold mb-1">Edit user</h1><p class="text-secondary mb-0">Update account details and access.</p></div>
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <input type="hidden" asp-for="UserId" />
            <div class="mb-3"><label asp-for="FullName" class="form-label fw-semibold">Full name</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Role" class="form-label fw-semibold"></label><select asp-for="Role" class="form-select"><option>Sales Staff</option><option>Administrator</option></select></div>
            <div class="form-check mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Account is active</label></div>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-light" asp-page="/Users/Index">Cancel</a></div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
