@page
@model InventorySalesManagement.Pages.Users.CreateModel
@{ ViewData["Title"] = "Add user"; }
<div class="mb-4"><a asp-page="/Users/Index" class="text-decoration-none">&larr; Back to users</a></div>
<div class="row"><div class="col-lg-8 col-xl-7">
    <div class="mb-4"><p class="text-primary text-uppercase fw-semibold small mb-1">Administration</p><h1 class="h2 fw-bold mb-1">Add user</h1><p class="text-secondary mb-0">Create an account and assign a role.</p></div>
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <div class="mb-3"><label asp-for="FullName" class="form-label fw-semibold">Full name</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="UserName" class="form-label fw-semibold">Username</label><input asp-for="UserName" class="form-control" /><span asp-validation-for="UserName" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label fw-semibold">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">Use at least 10 characters.</div><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="mb-4"><label asp-for="Role" class="form-label fw-semibold"></label><select asp-for="Role" class="form-select"><option>Sales Staff</option><option>Administrator</option></select></div>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Save user</button><a class="btn btn-light" asp-page="/Users/Index">Cancel</a></div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
